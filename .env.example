AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-dummy-key-replace-me
# Required only to use `maithinking` as the target model (see README).
MAI_THINKING_URL=
MAI_THINKING_DEPLOYMENT_NAME=your-deployment-name

# Required only to use `rc34` as the target model (see README).
# Gateway hostnames and deployment names are environment-specific and are NOT
# committed — fill these in locally.
#
# Route by DEPLOYMENT name, not deployment GROUP: a launcher's in-cluster
# command (a *.svc.cluster.local address with x-deployment-group-name) only
# works from inside the cluster. From a laptop, use the externally reachable
# gateway for that cluster with x-deployment-name naming one deployment.
#
# Gateway base URL (no path); /generate is appended.
# e.g. RC34_BASE_URL=http://your-inference-gateway:8080
RC34_BASE_URL=
# Optional alternative to RC34_BASE_URL: a JSON object of cluster -> base URL,
# selected with RC34_CLUSTER. Useful when you switch between clusters.
# e.g. RC34_CLUSTER_GATEWAYS={"clusterA":"http://gateway-a:8080","clusterB":"http://gateway-b:8080"}
#      RC34_CLUSTER=clusterA
RC34_CLUSTER_GATEWAYS=
RC34_CLUSTER=
# Which deployment to route to (x-deployment-name). Deployments are retired
# over time; update this when the current one stops serving. Check with:
#   curl -sS "$RC34_BASE_URL/v1/models" -H "x-deployment-name: $RC34_DEPLOYMENT_NAME"
# e.g. RC34_DEPLOYMENT_NAME=someuser-somegroup-1-abcd
RC34_DEPLOYMENT_NAME=
# Optional: output token budget (default 16000; retries escalate from there).
RC34_MAX_TOKENS=
